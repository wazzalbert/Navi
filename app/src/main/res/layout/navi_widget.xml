<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/navi_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Baris 1: nama dan jam -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/navi_cyan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="@color/navi_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/navi_cyan"
                android:textSize="20sp"
                android:shadowColor="@color/navi_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />
        </LinearLayout>

        <!-- Baris 2: sapaan -->
        <TextView
            android:id="@+id/widget_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="@string/widget_sample_greeting"
            android:textColor="@color/navi_green"
            android:textSize="12sp" />

        <!-- Baris 3: pesan terakhir (mengisi sisa ruang) -->
        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="@string/widget_sample_message"
            android:textColor="@color/navi_green_dim"
            android:textSize="11sp" />

        <!-- Baris 4: status dan tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_link_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="@string/status_online"
                    android:textColor="@color/navi_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_core_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="@string/widget_sample_core"
                    android:textColor="@color/navi_cyan_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_open_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/navi_button_bg"
                android:contentDescription="@string/widget_open_description"
                android:fontFamily="monospace"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="@string/widget_open_button"
                android:textColor="@color/navi_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay scanline CRT halus. Margin 4dp agar tidak keluar dari sudut membulat. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:background="@drawable/scanlines"
        android:importantForAccessibility="no" />
</FrameLayout>
