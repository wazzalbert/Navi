<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navi_bg">

    <LinearLayout
        android:id="@+id/chat_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="@string/chat_title"
            android:textColor="@color/navi_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="@color/navi_glow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/navi_line"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:text="@string/chat_placeholder"
            android:textColor="@color/navi_green"
            android:textSize="13sp" />

        <Button
            android:id="@+id/chat_back_button"
            style="@style/NaviButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chat_back_button" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scanlines"
        android:importantForAccessibility="no" />
</FrameLayout>
