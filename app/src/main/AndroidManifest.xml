<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hanya untuk mengetahui status ONLINE/OFFLINE. Izin INTERNET dan
         RECORD_AUDIO sengaja belum diminta; keduanya ditambahkan pada tahap
         yang benar-benar memakainya. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Navi">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Widget home screen. Tidak membutuhkan RECEIVE_BOOT_COMPLETED:
             setelah reboot launcher memulihkan widget dan sistem memanggil
             onUpdate; tampilan dibangun ulang dari data yang tersimpan. -->
        <receiver
            android:name=".widget.NaviWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/navi_widget_info" />
        </receiver>

    </application>

</manifest>
